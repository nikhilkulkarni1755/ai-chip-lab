# EQY proof 1 of 2 -- per PE:  RTL mac_int8 == mac_int8 in the gate netlist.
# (The netlist keeps the hierarchy, so this one module is the MAC of all
# 16 PEs.)  Two partitions: `prod` (the INT8 x INT8 multiplier) and `acc`
# (32-bit adder + accumulator register).
# Strategy: SymbiYosys/SMT with x-propagation for every partition.  EQY's
# built-in `use sat` strategy is NOT used: in this tool version it reported a
# deliberately broken design as equivalent (see the negative controls in
# scripts/t1_run.sh, which must FAIL for the stage to pass).
# Template: scripts/t1_run.sh substitutes @RTL@ and @NETLIST@.
[gold]
read_verilog -sv @RTL@/mac_int8.sv
prep -top mac_int8

[gate]
read_verilog -icells @NETLIST@
prep -top mac_int8

[strategy smt]
use sby
depth 2
engine smtbmc yices
