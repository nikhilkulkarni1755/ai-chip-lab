# SymbiYosys proof of the MAC:  acc_next == acc + sext(a)*sext(b) when valid,
# zero on clear, hold otherwise.   Run from this directory:
#   sby -f --prefix <workdir>/mac mac.sby          (tasks: bmc, prove, cover)
[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 5
cover: mode cover
cover: depth 8

[engines]
smtbmc yices

[script]
read_verilog -sv -formal mac_int8.sv
read_verilog -sv -formal mac_formal.sv
prep -top mac_formal

[files]
../rtl/mac_int8.sv
mac_formal.sv
